{
  "manifest_version": 3,
  "name": "AdFilter",
  "version": "3.1.3",
  "description": "Brave-Style Universal Ad Filter Extension for Web, Manga, Movie Streaming & YouTube",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*",
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_adnetworks",
        "enabled": true,
        "path": "rules/rules_adnetworks.json"
      },
      {
        "id": "ruleset_global",
        "enabled": true,
        "path": "rules/rules_global.json"
      },
      {
        "id": "ruleset_vietnam",
        "enabled": true,
        "path": "rules/rules_vietnam.json"
      },
      {
        "id": "ruleset_redirects",
        "enabled": true,
        "path": "rules/rules_redirects.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["resources/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["defuser.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://www.google.com/recaptcha/*",
        "*://www.gstatic.com/recaptcha/*",
        "*://*.arkoselabs.com/*",
        "*://*.funcaptcha.com/*",
        "*://*.captcha-delivery.com/*",
        "*://*.datadome.co/*",
        "*://*.geetest.com/*",
        "*://*.ddos-guard.net/*",
        "*://*.awswaf.com/*",
        "*://*.perimeterx.net/*",
        "*://*.px-cdn.net/*",
        "*://*/cdn-cgi/challenge-platform/*",
        "*://*/cdn-cgi/l/chk_*",
        "*://*.chatgpt.com/*",
        "*://*.openai.com/*",
        "*://*.claude.ai/*",
        "*://*.anthropic.com/*",
        "*://accounts.google.com/*",
        "*://login.microsoftonline.com/*",
        "*://login.live.com/*",
        "*://appleid.apple.com/*",
        "*://*.github.com/*",
        "*://*.auth0.com/*",
        "*://*.okta.com/*"
      ],
      "js": ["universalDefuser.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["cosmetic.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://www.google.com/recaptcha/*",
        "*://www.gstatic.com/recaptcha/*",
        "*://*.arkoselabs.com/*",
        "*://*.funcaptcha.com/*",
        "*://*.captcha-delivery.com/*",
        "*://*.datadome.co/*",
        "*://*.geetest.com/*",
        "*://*.ddos-guard.net/*",
        "*://*.awswaf.com/*",
        "*://*.perimeterx.net/*",
        "*://*.px-cdn.net/*",
        "*://*/cdn-cgi/challenge-platform/*",
        "*://*/cdn-cgi/l/chk_*",
        "*://*.chatgpt.com/*",
        "*://*.openai.com/*",
        "*://*.claude.ai/*",
        "*://*.anthropic.com/*",
        "*://accounts.google.com/*",
        "*://login.microsoftonline.com/*",
        "*://login.live.com/*",
        "*://appleid.apple.com/*",
        "*://*.github.com/*",
        "*://*.auth0.com/*",
        "*://*.okta.com/*"
      ],
      "js": ["universalContent.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}