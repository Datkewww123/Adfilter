{
  "manifest_version": 3,
  "name": "AdFilter",
  "version": "0.1.0",
  "description": "YouTube Ad Filter Extension",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
