{
  "name": "adfilter",
  "version": "1.0.0",
  "description": "YouTube Ad Filter Extension (Manifest V3) with Pure Core, Observability & Terraform Cloud CD",
  "main": "index.js",
  "scripts": {
    "build": "tsx scripts/build.ts --target=chromium",
    "build:dev": "tsx scripts/build.ts --target=chromium --dev",
    "build:firefox": "tsx scripts/build.ts --target=firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "verify:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm eval --min-precision=0.9 --min-recall=0.9 && pnpm build && pnpm build:firefox",
    "pull": "node scripts/pull-fixtures.mjs",
    "fixtures:pull": "node scripts/pull-fixtures.mjs",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "relabel": "tsx scripts/relabel.ts",
    "eval": "tsx scripts/eval.ts",
    "sweep": "tsx scripts/sweep.ts",
    "summarize": "tsx scripts/summarize-actions.ts",
    "canary": "tsx canary/check.ts",
    "package": "tsx scripts/package.ts",
    "e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.4",
    "http-server": "^14.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "prom-client": "^15.1.3"
  }
}
